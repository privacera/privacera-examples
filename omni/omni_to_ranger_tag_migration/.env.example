# Omni to Ranger Tag Migration Configuration
# Copy this file to .env and update with your actual values

# Required: API Key for authentication
API_KEY=your_api_key_here

# Required: Service name (e.g., privacera_snowflake)
SERVICE_NAME=privacera_snowflake

# Required: Service type in Capital (e.g., SNOWFLAKE, DATABRICKS_UNITY_CATALOG)
SERVICE_TYPE=SNOWFLAKE

# Optional: Ranger API username for basic authentication
RANGER_USERNAME=admin

# Optional: Ranger API password for basic authentication
RANGER_PASSWORD=admin