# Ranger to Omni Metadata Migration Configuration
# Copy this file to .env and update with your values

# API Key for Privacera Cloud (will be appended to https://api.privaceracloud.com/api/)
# The base URL is hardcoded in run_migration.sh
API_KEY=your_api_key_here

# Name of the service to migrate
SERVICE_NAME=privacera_snowflake

# Service type (e.g., SNOWFLAKE, DATABRICKS_UNITY_CATALOG, HIVE)
# Must be specified in UPPERCASE
SERVICE_TYPE=SNOWFLAKE

# Tag type to apply to all tag definitions
# Supported values: Sensitive, Confidential, Internal, Public
TAG_TYPE=Internal

# Batch size for syncing resources and tag-resource mappings
# Set to 0 to disable batching (send all at once)
BATCH_SIZE=100
